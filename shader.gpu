// ================== VERTEX SHADER =====================
var vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tangent;
attribute vec2 texCoord;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 ModelViewMatrix;
uniform vec3 lightPos;

// Параметри для трансформації текстури
uniform vec2 uPivot;    // Точка повороту (u, v)
uniform float uAngle;   // Кут в радіанах
uniform float uScale;   // Коефіцієнт масштабу

varying vec2 vTexCoord;
varying vec3 vPosView;
varying vec3 vNormalView;
varying vec3 vTangentView;
varying vec3 vLightPosView;

void main() {
    vec4 posView4 = ModelViewMatrix * vec4(vertex, 1.0);
    vPosView = posView4.xyz;

    vNormalView  = normalize( (ModelViewMatrix * vec4(normal,  0.0)).xyz );
    vTangentView = normalize( (ModelViewMatrix * vec4(tangent, 0.0)).xyz );
    vLightPosView = (ModelViewMatrix * vec4(lightPos, 1.0)).xyz;

    // --- ТРАНСФОРМАЦІЯ ТЕКСТУРНИХ КООРДИНАТ ---
    
    // 1. Переносимо в початок координат відносно точки Pivot
    vec2 uv = texCoord - uPivot;

    // 2. Масштабуємо (ділимо, щоб при збільшенні scale текстура ставала більшою)
    uv = uv / uScale;

    // 3. Обертаємо за допомогою матриці повороту 2D
    float s = sin(uAngle);
    float c = cos(uAngle);
    mat2 rotationMatrix = mat2(c, -s, s, c);
    uv = rotationMatrix * uv;

    // 4. Повертаємо назад до позиції Pivot
    vTexCoord = uv + uPivot;

    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}
`;

// ================== FRAGMENT SHADER =====================
var fragmentShaderSource = `
precision mediump float;

varying vec2 vTexCoord;
varying vec3 vPosView;
varying vec3 vNormalView;
varying vec3 vTangentView;
varying vec3 vLightPosView;

uniform sampler2D uDiffuseSampler;
uniform sampler2D uSpecularSampler;
uniform sampler2D uNormalSampler;

void main() {
    // --- 1) Gram-Schmidt (Ортонормування) ---
    vec3 N = normalize(vNormalView);
    vec3 T = normalize(vTangentView);
    T = normalize(T - dot(T, N) * N);
    vec3 B = normalize(cross(N, T));

    // --- 2) Normal map (Tangent space) ---
    // Використовуємо трансформовані vTexCoord
    vec3 normalTex = texture2D(uNormalSampler, vTexCoord).rgb;
    normalTex = normalTex * 2.0 - 1.0; 
    vec3 N_tangent = normalize(normalTex);
    mat3 TBN = mat3(T, B, N);
    vec3 N_view = normalize(TBN * N_tangent);

    // --- 3) Вектори освітлення ---
    vec3 L = normalize(vLightPosView - vPosView);
    vec3 V = normalize(-vPosView);
    vec3 R = reflect(-L, N_view);

    // --- 4) Текстури ---
    vec3 diffuseTex  = texture2D(uDiffuseSampler,  vTexCoord).rgb;
    vec3 specularTex = texture2D(uSpecularSampler, vTexCoord).rgb;

    // --- 5) Розрахунок освітлення за Фонгом (Ambient + Diffuse + Specular) ---
    float ambientStrength = 0.2;
    vec3 ambient = ambientStrength * diffuseTex;

    float diff = max(dot(N_view, L), 0.0);
    vec3 diffuse = diff * diffuseTex;

    float spec = 0.0;
    if (diff > 0.0) {
        spec = pow(max(dot(R, V), 0.0), 32.0); // Блиск (shininess)
    }
    vec3 specular = spec * specularTex;

    vec3 color = ambient + diffuse + specular;
    gl_FragColor = vec4(color, 1.0);
}
`;